{
  "name": "aip-backend",
  "version": "1.0.0",
  "description": "Agentic Intelligence Platform - Backend API",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "npx tsx src/index.ts",
    "migrate": "npx tsx src/db/migrate.ts",
    "seed": "npx tsx src/scripts/seed-agents.ts",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.143",
    "@anthropic-ai/sdk": "^0.97.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.0.0",
    "neo4j-driver": "^5.28.3",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.11.1",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
