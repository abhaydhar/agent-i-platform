# Copy to .env and fill in values.

NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://aip_user:aip_password@localhost:5432/aip

# Anthropic — use either API key or auth token + base URL (e.g. Databricks proxy).
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Agent loop: `messages` (default, in-process Messages API + MCP) or `agent-sdk` (Claude Agent SDK subprocess).
# Use `messages` when ANTHROPIC_BASE_URL points to a non-Anthropic proxy unless you have verified Agent SDK support.
AGENT_EXECUTOR_BACKEND=messages

# When false (default), MCP list_files/read_file are not registered — use AGENT_EXECUTOR_BACKEND=agent-sdk for Read/Glob/Grep.
# USE_MCP_FILESYSTEM_TOOLS=true

# When false, AST MCP tools are never registered (even if the agent has code-ast-parse).
ENABLE_CODE_PARSER_TOOLS=true
# Agent SDK only: allow Bash when use_neo4j is false (default false — prefer Grep).
# AGENT_SDK_ALLOW_BASH=false

MAX_AGENT_ITERATIONS=40
MAX_AGENT_TOKENS_PER_CALL=8192
MAX_FILE_BYTES=200000
MAX_FILES_PER_RUN=25

FS_SANDBOX_ROOT=
# FS_ALLOWED_ROOT=

NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

DEBUG=
