# Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://aip_user:aip_password@localhost:5432/aip

# ─── Anthropic credentials ────────────────────────────────────────────────────
# Use ONE of the two auth modes below.
#
# Mode A — Anthropic direct (api.anthropic.com):
#   Set only ANTHROPIC_API_KEY. Leave AUTH_TOKEN and BASE_URL unset.
#ANTHROPIC_API_KEY=sk_your_key_here
#
# Mode B — Proxy / gateway with Bearer auth (e.g. Databricks Foundation Models):
#   Set ANTHROPIC_AUTH_TOKEN to the bearer token, and ANTHROPIC_BASE_URL to the
#   gateway's Anthropic-compatible endpoint. The SDK will send
#   "Authorization: Bearer <token>" instead of "x-api-key".
#ANTHROPIC_AUTH_TOKEN=dapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#ANTHROPIC_BASE_URL=https://<workspace>.cloud.databricks.com/serving-endpoints/<endpoint>/invocations/anthropic
#ANTHROPIC_MODEL=databricks-claude-sonnet-4-5

# Neo4j Configuration
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Optional knobs for the agent loop
#MAX_AGENT_ITERATIONS=8
#MAX_FILE_BYTES=200000
#MAX_FILES_PER_RUN=25
#FS_SANDBOX_ROOT=./

# Debug Mode
DEBUG=aip:*
